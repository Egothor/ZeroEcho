{
  "name": "zeroecho-pki-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "ZeroEcho PKI administration Single-Page Application \u2014 a descriptor-driven, enterprise administration interface over the pki-server admin API.",
  "type": "module",
  "license": "BSD-4-Clause",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('../LICENSE-binary.txt', 'dist/LICENSE-binary.txt');\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/roboto-mono": "^5.1.0",
    "@mui/icons-material": "^6.1.9",
    "@mui/material": "^6.1.9",
    "@mui/x-data-grid": "^7.23.1",
    "@mui/x-date-pickers": "^7.23.1",
    "@tanstack/react-query": "^5.62.7",
    "date-fns": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
