{
  "name": "zeroecho-pki-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "ZeroEcho PKI administration Single-Page Application — a descriptor-driven, enterprise administration interface over the pki-server admin API.",
  "type": "module",
  "license": "BSD-4-Clause",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
