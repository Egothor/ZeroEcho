###############################################################################
# ZeroEcho PKI deployment — environment template.
#
# Copy to deploy/.env and fill in. NEVER commit a filled-in .env. Secrets are
# read only from the environment; they are never written into the image or into
# server-config.json (which contains only the *names* of these variables).
#
# Used by deploy/compose/docker-compose.yml and deploy/smoke-test.sh.
###############################################################################

# ---------------------------------------------------------------------------
# Secrets (passwords-by-env). Each name matches a *PasswordEnvironment field in
# server-config.json, or runtime.keyUnlockEnvironmentVariable.
# ---------------------------------------------------------------------------
# Unlocks the CA signing keyring (runtime.keyUnlockEnvironmentVariable).
ZEROECHO_KEYRING_PASSWORD=change-me-keyring

# PKCS#12 passwords for pki-server's own TLS material.
ZEROECHO_TLS_KEYSTORE_PASSWORD=change-me-tls-keystore
# Truststore that admits the reverse proxy's transport certificate (server TLS
# listener trust in TRUSTED_REVERSE_PROXY mode).
ZEROECHO_PROXY_TRUSTSTORE_PASSWORD=change-me-proxy-truststore
# Truststore for administrativeClientTrust (validates the forwarded admin leaf).
ZEROECHO_ADMIN_TRUSTSTORE_PASSWORD=change-me-admin-truststore

# ---------------------------------------------------------------------------
# Host paths mounted read-only into pki-server.
# Compose resolves relative bind paths from deploy/compose/, not this .env file.
# Run from repository root with --env-file deploy/.env.
# ---------------------------------------------------------------------------
# The strict versioned server configuration (schema version 7). Start from
# docs/pki-server-trusted-proxy-rfc9440-example.json for the nginx topology.
ZEROECHO_SERVER_CONFIG_FILE=../config/server-config.json
# Explicit trusted local bootstrap identity; must use the same store as server.
ZEROECHO_PROFILE_BOOTSTRAP_CONFIG_FILE=../pki-server/profile-bootstrap.json
ZEROECHO_PROFILE_RECONCILE=on
# Directory of certificate-profile JSON documents (schemaVersion 5). The
# entrypoint registers+activates any whose profileId is not already present.
ZEROECHO_PROFILES_HOST_DIR=../pki-server/profiles
# pki-server TLS material dir; server-config.json references files under it as
# tls/... (mounted at /var/lib/zeroecho/tls, the server working dir).
#   server-identity.p12, proxy-transport-trust.p12, administrators-trust.p12
ZEROECHO_TLS_HOST_DIR=../tls/server
# Health-probe client identity dir (PEM): health-client.pem, health-client-key.pem,
# health-ca.pem. Its issuer MUST be trusted by the admin listener's client trust.
ZEROECHO_HEALTH_HOST_DIR=../tls/health

# ---------------------------------------------------------------------------
# nginx edge.
# ---------------------------------------------------------------------------
NGINX_SERVER_NAME=pki.example.com
# Cert name expected on pki-server's server certificate (proxy_ssl_name / SNI).
PKI_PROXY_SSL_NAME=zeroecho-admin
# Host ports to publish (container listens on 8443 TLS and 80 HTTP internally).
NGINX_PUBLISH_HTTPS=8443
NGINX_PUBLISH_HTTP=8080
# nginx edge TLS material (browser-facing): edge.crt, edge.key.
NGINX_EDGE_TLS_DIR=../tls/edge
# Browser mTLS trust bundle: admin-ca-bundle.pem (PEM CA chain).
NGINX_ADMIN_TRUST_DIR=../tls/admin-trust
# Upstream mTLS: proxy-client.crt, proxy-client.key, pki-server-ca.pem.
NGINX_UPSTREAM_TLS_DIR=../tls/upstream

# ---------------------------------------------------------------------------
# smoke-test.sh only.
# ---------------------------------------------------------------------------
# Base URL of the running edge (through nginx).
SMOKE_BASE_URL=https://localhost:8443
# Admin client identity used by the smoke test (PEM cert + key + CA bundle).
SMOKE_ADMIN_CERT=./tls/smoke/admin-client.pem
SMOKE_ADMIN_KEY=./tls/smoke/admin-client-key.pem
SMOKE_CA_BUNDLE=./tls/smoke/edge-ca.pem

# Existing issuer and active profile; configure real IDs before running smoke.
SMOKE_CA_ID=
SMOKE_PROFILE_ID=
# Exactly one: existing CSR ID, or full version-1 request.import JSON envelope.
SMOKE_REQUEST_ID=
SMOKE_IMPORT_ARGS_FILE=
# Optional installed bin/app (paths for SMOKE_* resolve from deploy/).
# SMOKE_CLI=../app/build/install/app/bin/app
# SMOKE_* values are literal, without shell evaluation or variable expansion.
