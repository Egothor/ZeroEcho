{
  "version": 1,
  "store": {
    "provider": "fs",
    "properties": {
      "root": "build/packaged-cli-store"
    }
  },
  "audit": {
    "provider": "memory",
    "properties": {
      "size": "64"
    }
  },
  "publishers": [
    {
      "provider": "filesystem",
      "properties": {
        "root": "build/packaged-cli-publication",
        "targetId": "local-artifacts"
      }
    }
  ],
  "mode": "local",
  "operatorId": "packaged-cli-operator",
  "bindingProviders": []
}
